{
  "manifest_version": 3,
  "name": "Netflix IMDb Ratings Overlay",
  "version": "0.4.0",
  "description": "Shows an IMDb rating badge next to the Netflix title in the more-details view using OMDb.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.omdbapi.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "src/netflix-ratings-core.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Netflix IMDb Ratings Overlay"
  }
}
