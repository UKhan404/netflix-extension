{
  "manifest_version": 3,
  "name": "Netflix Ratings Overlay",
  "version": "0.2.0",
  "description": "Adds IMDb, Rotten Tomatoes, and optional MyDramaList ratings to Netflix without removing any Netflix UI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.omdbapi.com/*",
    "https://api.mydramalist.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "src/netflix-ratings-core.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Netflix Ratings Overlay"
  }
}
